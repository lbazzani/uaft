# UAFT Environment Variables Example
# Copia questo file in .env.local per la configurazione locale

# Next.js
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (esempio)
# NEXT_PUBLIC_GA_ID=UA-XXXXX-X

# Contact Form (quando lo implementeremo)
# CONTACT_EMAIL=info@uaft.example.com

# AI del Sales Agent e dell'AI Pricing Engine: servizio claude-runner della
# piattaforma SparkTech (server-sparktech, docs/piattaforma/claude-runner.md).
# Senza queste variabili la chat risponde con le frasi di riserva.
# In sviluppo sul Mac: tunnel SSH verso il runner di sparktech2, poi
#   ssh -f -N -L 18790:10.10.1.2:8790 sparktech2
CLAUDE_RUNNER_URLS=sparktech2=http://127.0.0.1:18790
CLAUDE_RUNNER_TOKEN=il-bearer-del-runner
# CLAUDE_RUNNER_MODEL=sonnet
